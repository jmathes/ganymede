# Copy to .env (gitignored). Loaded by the ganymede CLI; existing env vars take precedence.
ARISTOTLE_API_KEY=
# Claude backend. Default "auto": uses the Anthropic API if ANTHROPIC_API_KEY is set, otherwise
# shells out to `claude -p`, which uses your Claude Code login and draws on your Claude subscription.
# GANYMEDE_CLAUDE_BACKEND=cli
# ANTHROPIC_API_KEY=
# GANYMEDE_MODEL=claude-opus-5
# GANYMEDE_NOTIFY_CMD=mail -s "ganymede" you@example.com
